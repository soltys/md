# Tree-sitter grammars for syntax highlighting inside fenced code blocks.
# Each grammar is compiled as its own static library; its highlights.scm is
# embedded into a generated C file.
include(FetchContent)

set(MD_GRAMMAR_LIBS "")

# The parse tables of these grammars are most of md.exe (~13 MB, mostly
# zeros). With MD_PACK_GRAMMARS they are stored zstd-compressed instead
# (well under 1 MB) and unpacked the first time a code block in that
# language is highlighted: a smaller exe is faster for Windows and
# antivirus to load on every start. How:
#   1. tools/ts_pack.c is built once per grammar around the original
#      parser.c and writes the two tables, compressed, as generated C.
#   2. md compiles an edited copy of parser.c (made here, at configure
#      time) whose tables are uninitialised arrays (no space in the file)
#      and whose tree_sitter_<id>() unpacks them on first use
#      (src/grammar_pack.c).
option(MD_PACK_GRAMMARS "Store the highlighting grammars' parse tables compressed" ON)

# Replaces the C definition that starts with <head> (up to the "};" line
# that ends it) with <replacement>.
function(_md_cut_definition var head replacement file)
    string(FIND "${${var}}" "${head}" _at)
    if(_at EQUAL -1)
        message(FATAL_ERROR "${file}: '${head}' not found; set MD_PACK_GRAMMARS=OFF")
    endif()
    string(SUBSTRING "${${var}}" ${_at} -1 _rest)
    string(FIND "${_rest}" "\n};\n" _len)
    if(_len EQUAL -1)
        message(FATAL_ERROR "${file}: end of '${head}' not found; set MD_PACK_GRAMMARS=OFF")
    endif()
    string(SUBSTRING "${${var}}" 0 ${_at} _before)
    math(EXPR _skip "${_len} + 4")
    string(SUBSTRING "${_rest}" ${_skip} -1 _after)
    set(${var} "${_before}${replacement}\n${_after}" PARENT_SCOPE)
endfunction()

# Writes generated/ts_<id>/parser.c: the grammar's parser.c without its
# parse tables, see above.
function(_md_packed_parser id src out)
    if(EXISTS "${out}" AND NOT "${src}" IS_NEWER_THAN "${out}")
        return()
    endif()
    message(STATUS "Preparing the ${id} grammar for packed parse tables")
    file(READ "${src}" _c)
    _md_cut_definition(_c
        "static const uint16_t ts_parse_table[LARGE_STATE_COUNT][SYMBOL_COUNT] = {"
        "static uint16_t ts_parse_table[LARGE_STATE_COUNT][SYMBOL_COUNT]; /* packed */" "${src}")
    _md_cut_definition(_c
        "static const uint16_t ts_small_parse_table[] = {"
        "static uint16_t ts_small_parse_table[MD_TS_SMALL_PARSE_TABLE_LEN]; /* packed */" "${src}")
    set(_fn "TS_PUBLIC const TSLanguage *tree_sitter_${id}(void) {")
    string(FIND "${_c}" "${_fn}" _at)
    if(_at EQUAL -1)
        message(FATAL_ERROR "${src}: '${_fn}' not found; set MD_PACK_GRAMMARS=OFF")
    endif()
    string(REPLACE "${_fn}" "static const TSLanguage *md_unpacked_language(void) {" _c "${_c}")
    file(WRITE "${out}" "/* Generated by cmake/Grammars.cmake from ${src}:
 * the parse tables are filled from md_ts_${id}_pack on first use. */
#include \"ts_${id}_pack.h\"
${_c}
#include \"grammar_pack.h\"
extern const unsigned char md_ts_${id}_pack[];
extern const size_t md_ts_${id}_pack_len;
static MdGrammarPack md_pack = {
    {0}, md_ts_${id}_pack,
    ts_parse_table, sizeof ts_parse_table,
    ts_small_parse_table, sizeof ts_small_parse_table,
    \"${id}\",
};
const TSLanguage *tree_sitter_${id}(void) {
  return md_grammar_unpack(&md_pack, md_ts_${id}_pack_len) ? md_unpacked_language() : NULL;
}
")
endfunction()
set(_queries_c "${CMAKE_CURRENT_BINARY_DIR}/generated/queries.c")
set(_queries_body "/* Generated by cmake/Grammars.cmake. */\n#include <stddef.h>\n")

function(_md_embed_query out_var symbol file)
    file(READ "${file}" _hex HEX)
    string(LENGTH "${_hex}" _n)
    math(EXPR _bytes "${_n} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _arr "${_hex}")
    set(${out_var} "const unsigned char ${symbol}[] = {${_arr}0x00};\nconst size_t ${symbol}_len = ${_bytes};\n" PARENT_SCOPE)
endfunction()

# md_add_grammar(<id> <release tarball url> <sha256>)
# md_add_grammar(<id> <repo>.git <tag>)
# Grammars are fetched as the source tarballs attached to their GitHub
# releases (generated parser.c included), which is much faster than cloning.
# A .git URL falls back to a shallow clone for releases without a usable
# tarball.
macro(md_add_grammar id url ref)
    if("${url}" MATCHES "\\.git$")
        FetchContent_Declare(ts_${id}
            GIT_REPOSITORY ${url}
            GIT_TAG        ${ref}
            GIT_SHALLOW    TRUE
            GIT_SUBMODULES ""
            SOURCE_SUBDIR  do-not-add)
    else()
        FetchContent_Declare(ts_${id}
            URL           ${url}
            URL_HASH      SHA256=${ref}
            SOURCE_SUBDIR do-not-add)
    endif()
    FetchContent_MakeAvailable(ts_${id})
    set(_src "${ts_${id}_SOURCE_DIR}/src")
    set(_scanner "")
    if(EXISTS "${_src}/scanner.c")
        set(_scanner "${_src}/scanner.c")
    endif()
    if(MD_PACK_GRAMMARS)
        set(_gen "${CMAKE_CURRENT_BINARY_DIR}/generated/ts_${id}")
        _md_packed_parser(${id} "${_src}/parser.c" "${_gen}/parser.c")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_src}/parser.c")
        # The build-time packer, around the original parser.c.
        add_executable(md_ts_pack_${id} tools/ts_pack.c ${_scanner})
        target_compile_definitions(md_ts_pack_${id} PRIVATE MD_PARSER_C="${_src}/parser.c")
        target_include_directories(md_ts_pack_${id} PRIVATE "${_src}")
        target_link_libraries(md_ts_pack_${id} PRIVATE md_zstd_tools md_tree_sitter)
        add_custom_command(
            OUTPUT "${_gen}/pack.c" "${_gen}/ts_${id}_pack.h"
            COMMAND md_ts_pack_${id} "${_gen}/pack.c" "${_gen}/ts_${id}_pack.h" ${id}
            DEPENDS md_ts_pack_${id}
            COMMENT "Packing the ${id} grammar's parse tables"
            VERBATIM)
        add_library(md_ts_${id} STATIC "${_gen}/parser.c" "${_gen}/pack.c"
            "${_gen}/ts_${id}_pack.h" ${_scanner})
        target_include_directories(md_ts_${id} PRIVATE "${_src}" "${_gen}"
            "${CMAKE_CURRENT_SOURCE_DIR}/src")
        target_link_libraries(md_ts_${id} PRIVATE SDL3::Headers)
        set(_targets md_ts_${id} md_ts_pack_${id})
    else()
        add_library(md_ts_${id} STATIC "${_src}/parser.c" ${_scanner})
        target_include_directories(md_ts_${id} PRIVATE "${_src}")
        set(_targets md_ts_${id})
    endif()
    foreach(_t ${_targets})
        if(MSVC)
            target_compile_options(${_t} PRIVATE /W0 /utf-8)
        else()
            target_compile_options(${_t} PRIVATE -w)
        endif()
    endforeach()
    list(APPEND MD_GRAMMAR_LIBS md_ts_${id})
    _md_embed_query(_q md_query_${id} "${ts_${id}_SOURCE_DIR}/queries/highlights.scm")
    string(APPEND _queries_body "${_q}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${ts_${id}_SOURCE_DIR}/queries/highlights.scm")
endmacro()

