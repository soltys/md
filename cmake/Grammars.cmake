# Tree-sitter grammars for syntax highlighting inside fenced code blocks.
# Each grammar is compiled as its own static library; its highlights.scm is
# embedded into a generated C file.
include(FetchContent)

set(MD_GRAMMAR_LIBS "")
set(_queries_c "${CMAKE_CURRENT_BINARY_DIR}/generated/queries.c")
set(_queries_body "/* Generated by cmake/Grammars.cmake. */\n#include <stddef.h>\n")

function(_md_embed_query out_var symbol file)
    file(READ "${file}" _hex HEX)
    string(LENGTH "${_hex}" _n)
    math(EXPR _bytes "${_n} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _arr "${_hex}")
    set(${out_var} "const unsigned char ${symbol}[] = {${_arr}0x00};\nconst size_t ${symbol}_len = ${_bytes};\n" PARENT_SCOPE)
endfunction()

# md_add_grammar(<id> <release tarball url> <sha256>)
# md_add_grammar(<id> <repo>.git <tag>)
# Grammars are fetched as the source tarballs attached to their GitHub
# releases (generated parser.c included), which is much faster than cloning.
# A .git URL falls back to a shallow clone for releases without a usable
# tarball.
macro(md_add_grammar id url ref)
    if("${url}" MATCHES "\\.git$")
        FetchContent_Declare(ts_${id}
            GIT_REPOSITORY ${url}
            GIT_TAG        ${ref}
            GIT_SHALLOW    TRUE
            GIT_SUBMODULES ""
            SOURCE_SUBDIR  do-not-add)
    else()
        FetchContent_Declare(ts_${id}
            URL           ${url}
            URL_HASH      SHA256=${ref}
            SOURCE_SUBDIR do-not-add)
    endif()
    FetchContent_MakeAvailable(ts_${id})
    set(_src "${ts_${id}_SOURCE_DIR}/src")
    set(_files "${_src}/parser.c")
    if(EXISTS "${_src}/scanner.c")
        list(APPEND _files "${_src}/scanner.c")
    endif()
    add_library(md_ts_${id} STATIC ${_files})
    target_include_directories(md_ts_${id} PRIVATE "${_src}")
    if(MSVC)
        target_compile_options(md_ts_${id} PRIVATE /W0 /utf-8)
    else()
        target_compile_options(md_ts_${id} PRIVATE -w)
    endif()
    list(APPEND MD_GRAMMAR_LIBS md_ts_${id})
    _md_embed_query(_q md_query_${id} "${ts_${id}_SOURCE_DIR}/queries/highlights.scm")
    string(APPEND _queries_body "${_q}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${ts_${id}_SOURCE_DIR}/queries/highlights.scm")
endmacro()

